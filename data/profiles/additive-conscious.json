{
  "id": "additive-conscious",
  "name": "Additive-conscious",
  "description": "Prioritizes additive count and NOVA. Example profile for personal preference — not a toxicity assessment.",
  "version": 1,
  "builtin": true,
  "scale": { "kind": "numeric", "min": 0, "max": 100 },
  "base_score": 70,
  "missing_data": "incomplete",
  "default_missing_penalty": -8,
  "labels": [
    { "min": 80, "label": "Excellent", "tone": "good" },
    { "min": 60, "label": "Good", "tone": "good" },
    { "min": 35, "label": "Mediocre", "tone": "mediocre" },
    { "min": 0, "label": "Poor", "tone": "poor" }
  ],
  "criteria": [
    {
      "id": "additives",
      "title": "Additives",
      "attribute": "additives_n",
      "weight": 2.0,
      "polarity": "negative",
      "missing_policy": "incomplete",
      "rules": [
        { "when": { "op": "eq", "value": 0 }, "adjust": 10, "label": "No additives listed", "tone": "good" },
        { "when": { "op": "eq", "value": 1 }, "adjust": -3, "label": "One additive", "tone": "mediocre" },
        { "when": { "op": "lte", "value": 3 }, "adjust": -8, "label": "Several additives", "tone": "mediocre" },
        { "when": { "op": "gt", "value": 3 }, "adjust": -18, "label": "Many additives", "tone": "poor" }
      ]
    },
    {
      "id": "nova",
      "title": "NOVA group",
      "attribute": "nova_group",
      "weight": 1.0,
      "polarity": "negative",
      "rules": [
        { "when": { "op": "lte", "value": 2 }, "adjust": 6, "label": "Lower processing", "tone": "good" },
        { "when": { "op": "eq", "value": 3 }, "adjust": -4, "label": "Processed", "tone": "mediocre" },
        { "when": { "op": "eq", "value": 4 }, "adjust": -12, "label": "Ultra-processed", "tone": "poor" }
      ]
    },
    {
      "id": "organic",
      "title": "Organic label",
      "attribute": "organic",
      "weight": 0.5,
      "polarity": "positive",
      "missing_policy": "ignore",
      "rules": [
        { "when": { "op": "eq", "value": 1 }, "adjust": 8, "label": "Organic label present", "tone": "good" },
        { "when": { "op": "eq", "value": 0 }, "adjust": 0, "label": "No organic label", "tone": "neutral" }
      ]
    }
  ],
  "caps": [
    {
      "attribute": "additives_n",
      "when": { "op": "gte", "value": 5 },
      "max_score": 35,
      "label": "Hard cap when many additives"
    }
  ],
  "category_overrides": []
}
