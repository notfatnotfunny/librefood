{
  "id": "minimally-processed",
  "name": "Minimally processed foods",
  "description": "Emphasizes NOVA group and additives. Example profile — not an official processing classification.",
  "version": 1,
  "builtin": true,
  "scale": { "kind": "numeric", "min": 0, "max": 100 },
  "base_score": 60,
  "missing_data": "penalize",
  "default_missing_penalty": -6,
  "labels": [
    { "min": 75, "label": "Excellent", "tone": "good" },
    { "min": 55, "label": "Good", "tone": "good" },
    { "min": 30, "label": "Mediocre", "tone": "mediocre" },
    { "min": 0, "label": "Poor", "tone": "poor" }
  ],
  "criteria": [
    {
      "id": "nova",
      "title": "NOVA group",
      "attribute": "nova_group",
      "weight": 1.5,
      "polarity": "negative",
      "rules": [
        { "when": { "op": "eq", "value": 1 }, "adjust": 12, "label": "Unprocessed / minimally processed", "tone": "good" },
        { "when": { "op": "eq", "value": 2 }, "adjust": 4, "label": "Culinary ingredients", "tone": "good" },
        { "when": { "op": "eq", "value": 3 }, "adjust": -6, "label": "Processed foods", "tone": "mediocre" },
        { "when": { "op": "eq", "value": 4 }, "adjust": -18, "label": "Ultra-processed", "tone": "poor" }
      ]
    },
    {
      "id": "additives",
      "title": "Additives",
      "attribute": "additives_n",
      "weight": 1.2,
      "polarity": "negative",
      "rules": [
        { "when": { "op": "eq", "value": 0 }, "adjust": 8, "label": "No additives listed", "tone": "good" },
        { "when": { "op": "lte", "value": 2 }, "adjust": -4, "label": "Some additives", "tone": "mediocre" },
        { "when": { "op": "gt", "value": 2 }, "adjust": -14, "label": "Contains additives to avoid", "tone": "poor" }
      ]
    },
    {
      "id": "sugars",
      "title": "Sugars",
      "attribute": "sugars_100g",
      "weight": 0.8,
      "polarity": "negative",
      "rules": [
        { "when": { "op": "lte", "value": 5 }, "adjust": 3, "label": "Low sugar", "tone": "good" },
        { "when": { "op": "lte", "value": 15 }, "adjust": -4, "label": "Moderate sugar", "tone": "mediocre" },
        { "when": { "op": "gt", "value": 15 }, "adjust": -10, "label": "High sugar", "tone": "poor" }
      ]
    }
  ],
  "caps": [
    {
      "attribute": "nova_group",
      "when": { "op": "eq", "value": 4 },
      "max_score": 45,
      "label": "Cap for ultra-processed foods"
    }
  ],
  "category_overrides": []
}
