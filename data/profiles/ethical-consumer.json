{
  "id": "ethical-consumer",
  "name": "Ethical consumer",
  "description": "Combines the Boycott Israeli Businesses directory (api.boycottisraeli.biz) with WikiRate open ESG data (World Benchmarking Alliance Food & Agriculture Benchmark). Third-party sources — not legal or medical advice.",
  "version": 2,
  "builtin": true,
  "scale": { "kind": "numeric", "min": 0, "max": 100 },
  "base_score": 65,
  "missing_data": "unknown",
  "default_missing_penalty": -5,
  "labels": [
    { "min": 75, "label": "Clear", "tone": "good" },
    { "min": 50, "label": "Unclear", "tone": "mediocre" },
    { "min": 0, "label": "Concerning", "tone": "poor" }
  ],
  "criteria": [
    {
      "id": "boycott-list",
      "title": "Boycott list (boycottisraeli.biz)",
      "attribute": "boycott_listed",
      "weight": 1.0,
      "polarity": "negative",
      "missing_policy": "unknown",
      "rules": [
        {
          "when": { "op": "eq", "value": 1 },
          "adjust": -55,
          "label": "Brand listed — see why & alternatives",
          "tone": "poor"
        },
        {
          "when": { "op": "eq", "value": 0 },
          "adjust": 10,
          "label": "Brand not found on boycott list",
          "tone": "good"
        }
      ]
    },
    {
      "id": "wikirate-fab",
      "title": "WikiRate Food & Agriculture Benchmark",
      "attribute": "wikirate_score",
      "weight": 1.0,
      "polarity": "positive",
      "missing_policy": "unknown",
      "missing_penalty": -5,
      "rules": [
        {
          "when": { "op": "gte", "value": 50 },
          "adjust": 20,
          "label": "Strong WikiRate benchmark (≥50/100)",
          "tone": "good"
        },
        {
          "when": { "op": "gte", "value": 30 },
          "adjust": 8,
          "label": "Moderate WikiRate benchmark",
          "tone": "mediocre"
        },
        {
          "when": { "op": "gte", "value": 0 },
          "adjust": -12,
          "label": "Weak WikiRate benchmark",
          "tone": "poor"
        }
      ]
    }
  ],
  "caps": [
    {
      "attribute": "boycott_listed",
      "when": { "op": "eq", "value": 1 },
      "max_score": 30,
      "label": "Cap when brand is on the boycott list"
    }
  ],
  "category_overrides": []
}
